# Copy this file to ".env" (gitignored) and fill in the values.
# env-cmd loads it into the environment and k6 reads it via __ENV.
HOST="https://api.example.com"
USERNAME=""
PWD=""

# Optional:
# PAUSE_MIN=5              # min think-time between requests (seconds)
# PAUSE_MAX=10             # max think-time between requests (seconds)
# CONFIG_FILE=config/profiles/load.json   # load profile to run (default: load)
